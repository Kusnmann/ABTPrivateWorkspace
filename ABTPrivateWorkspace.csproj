<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ABTOpennessProtoDir Condition="'$(ABTOpennessProtoDir)' == ''">C:\Program Files\Siemens\ABT Site\Bin\ABTOpennessDocumentation\Proto Files</ABTOpennessProtoDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="$(ABTOpennessProtoDir)\ABTOpennessResult.proto" GrpcServices="None" ProtoRoot="$(ABTOpennessProtoDir)" />
    <Protobuf Include="$(ABTOpennessProtoDir)\ClientRegistrationService.proto" GrpcServices="Client" ProtoRoot="$(ABTOpennessProtoDir)" />
    <Protobuf Include="$(ABTOpennessProtoDir)\ProjectService.proto" GrpcServices="Client" ProtoRoot="$(ABTOpennessProtoDir)" />
  </ItemGroup>
</Project>
